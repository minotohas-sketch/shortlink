# Application
APP_ENV=development
APP_NAME=Peage
APP_URL=https://peage.io
API_URL=https://api.peage.io

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_ZONE_ID=

# D1 Database
D1_DATABASE_ID=
D1_DATABASE_NAME=peage-db

# KV Namespaces
KV_CACHE_ID=
KV_SESSIONS_ID=
KV_RATE_LIMIT_ID=

# R2 Storage
R2_BUCKET_NAME=peage-storage
R2_PUBLIC_URL=

# Queue
QUEUE_EMAIL=email-queue
QUEUE_ANALYTICS=analytics-queue
QUEUE_PAYOUT=payout-queue
QUEUE_NOTIFICATION=notification-queue

# JWT / Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Email (Resend)
RESEND_API_KEY=re_
EMAIL_FROM=noreply@peage.io
EMAIL_REPLY_TO=support@peage.io

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Payments (PayPal)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Rate Limiting
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100
RATE_LIMIT_CREATE_LINK=30

# CPM Rates
CPM_TIER_1=4.0
CPM_TIER_2=2.0
CPM_TIER_3=0.5
CPM_TIER_4=0.1

# Referral
REFERRAL_COMMISSION_PERCENT=10

# Withdrawal
MIN_WITHDRAWAL_AMOUNT=10
MAX_WITHDRAWAL_AMOUNT=5000
WITHDRAWAL_PROCESSING_DAYS=7

# Links
SHORT_CODE_LENGTH=7
LINK_MAX_REDIRECTS=5
LINK_EXPIRY_DAYS_DEFAULT=365

# Cache
CACHE_TTL_LINK=3600
CACHE_TTL_ANALYTICS=300
CACHE_TTL_USER=600

# Logging
LOG_LEVEL=info

# Feature Flags
FEATURE_REGISTRATION=true
FEATURE_PAYMENTS=true
FEATURE_REFERRALS=true
FEATURE_CUSTOM_DOMAINS=false
FEATURE_API_ACCESS=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
