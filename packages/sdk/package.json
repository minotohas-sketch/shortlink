{
  "name": "@peage/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Peage SDK — Client JavaScript/TypeScript pour l'API Peage",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
