{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "peage-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peage-db",
      "database_id": "{{D1_DATABASE_ID}}"
    }
  ],
  
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_CACHE",
      "id": "{{KV_CACHE_ID}}"
    }
  ],
  
  "queues": {
    "consumers": [
      {
        "queue": "analytics-queue",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "analytics-dlq"
      }
    ]
  },
  
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 0 * * *"
    ]
  },
  
  "env": {
    "staging": {
      "name": "peage-analytics-staging"
    },
    "production": {
      "name": "peage-analytics-production"
    }
  }
}
